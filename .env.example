# Django Settings
DEBUG=True
SECRET_KEY=your-very-long-random-secret-key-here-change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL for production)
DB_NAME=chegoloso_db
DB_USER=chegoloso_user
DB_PASSWORD=secure-password-here-change-this
DB_HOST=localhost
DB_PORT=5432

# Or use DATABASE_URL
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Email Configuration (optional)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Sentry Error Tracking (optional)
SENTRY_DSN=

# Redis Cache (optional)
REDIS_URL=redis://localhost:6379/0

# Company Info
COMPANY_NAME=CHE GOLOSO
COMPANY_ADDRESS=Av. Principal 123, Buenos Aires
COMPANY_PHONE=+54 11 1234-5678
COMPANY_CUIT=30-12345678-9
